{
  "name": "bandar",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run duck:fetch && bun run gen && bun run --parallel dev:web dev:server",
    "dev:web": "vp dev",
    "dev:server": "bun run gen && bun --watch src/server/main.ts",
    "gen": "bun scripts/gen.ts",
    "build:client": "vp build",
    "compile": "bun run duck:fetch && bun scripts/gen.ts --strict && bun build --compile src/server/main.ts --outfile dist/bandar",
    "build": "bun run build:client && bun run compile",
    "start": "bun scripts/start.ts",
    "check": "bun run gen && vp check",
    "check:fix": "bun run gen && vp check --fix",
    "test": "bun run gen && bun --bun vp test run",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run check && bun run test && bun run build && bun run smoke",
    "db:generate": "drizzle-kit generate",
    "db:auth-schema": "bunx @better-auth/cli generate --config scripts/auth-schema.config.ts --output src/server/db/auth-schema.ts --yes",
    "duck:fetch": "bun scripts/fetch-duckdb.ts",
    "postinstall": "bun run duck:fetch && bun scripts/gen.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.14",
    "@duckdb/node-bindings": "2.0.0-r.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@valibot/to-json-schema": "^1.8.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.22",
    "@oxlint/plugins": "1.89.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
